[flake8]
max-line-length = 88
extend-ignore =
    # E203: пробел перед ':' (black так делает, flake8 ругается)
    E203,
    # W503: перенос строки перед бинарным оператором (black так делает)
    W503,
    # E501: строка слишком длинная (black уже это контролирует, дублирование не нужно)
    E501
exclude =
    .git,
    __pycache__,
    .venv,
    poetry.lock
